GEMINI_API_KEY=your_key_here
SESSION_SECRET=change_this_to_a_random_string

# Local Postgres (replaces Supabase). App connects via DATABASE_URL.
POSTGRES_USER=brancher
POSTGRES_PASSWORD=change_me
POSTGRES_DB=brancher
DATABASE_URL=postgresql://brancher:change_me@brancher-postgres:5432/brancher

# LLM provider: auto | gemini | anthropic
# auto (default) uses Anthropic when ANTHROPIC_API_KEY is set, otherwise Gemini.
# If Gemini returns HTTP 400 "location is not supported" and an Anthropic key exists, one retry via Anthropic.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
# Default model is claude-opus-5. Override if needed:
# ANTHROPIC_MODEL=claude-opus-5

# Production (split deploy: frontend on Vercel, backend on this VPS)
NODE_ENV=production
FRONTEND_URL=https://your-frontend.vercel.app
